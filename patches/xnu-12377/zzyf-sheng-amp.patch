+ * sheng: the BCM2837 machine configuration targets baseline ARM64 without ARMv8.2-A atomics,
+ * where os_atomic_rmw_loop uses LL/SC and cannot operate on 128-bit registry state.
+ * Stir-the-pot is not used on this asymmetric topology (UI threads stay on P cores).
+ */
+static inline int
+sched_edge_stir_the_pot_try_trigger_swap(thread_t thread)
+{
+	(void)thread;
+	return -1;
+}
+
+void
