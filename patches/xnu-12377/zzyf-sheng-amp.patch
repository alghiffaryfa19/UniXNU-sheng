--- a/osfmk/kern/sched_clutch.c
+++ b/osfmk/kern/sched_clutch.c
@@ -1379,6 +1379,39 @@ sched_clutch_bucket_init(
 	queue_init(&clutch_bucket->scb_thread_timeshare_queue);
 }
 
+#if CONFIG_SCHED_EDGE
+/*
+ * sheng: no performance controller recommends clusters here, so a thread group starts with its fixed priority
+ * to default buckets on the first P cluster and its utility and background buckets on the boot cluster.
+ */
+static pset_id_t
+sched_edge_default_preferred_pset(sched_bucket_t bucket)
+{
+	if (bucket >= TH_BUCKET_SHARE_UT) {
+		return sched_boot_pset->pset_id;
+	}
+	/* The first pset of a cluster takes the cluster ID. */
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	for (unsigned int i = 0; i < topology->num_clusters; i++) {
+		if (topology->clusters[i].cluster_type == CLUSTER_TYPE_P) {
+			return (pset_id_t)topology->clusters[i].cluster_id;
+		}
+	}
+	return sched_boot_pset->pset_id;
+}
+
+/*
+ * sheng: fixed priority, UI and user-initiated threads that prefer the P cluster neither migrate nor get stolen to the E cluster.
+ * The A510 cores run at a fraction of the P cores' speed and no performance controller raises their clock for a frame, so
+ * such a thread waits for (or preempts lower work on) a P core instead.
+ */
+static bool
+sched_edge_ui_bucket_stays_on_p(pset_type_t from, pset_type_t to, sched_bucket_t bucket)
+{
+	return from == PSET_AMP_P && to == PSET_AMP_E && bucket < TH_BUCKET_SHARE_DF;
+}
+#endif /* CONFIG_SCHED_EDGE */
+
 /*
  * sched_clutch_bucket_group_init()
  *
@@ -1401,7 +1434,11 @@ sched_clutch_bucket_group_init(
 
 	os_atomic_store(&clutch_bucket_group->scbg_timeshare_tick, 0, relaxed);
 	os_atomic_store(&clutch_bucket_group->scbg_pri_shift, INT8_MAX, relaxed);
+#if CONFIG_SCHED_EDGE
+	os_atomic_store(&clutch_bucket_group->scbg_preferred_pset, sched_edge_default_preferred_pset(bucket), relaxed);
+#else /* CONFIG_SCHED_EDGE */
 	os_atomic_store(&clutch_bucket_group->scbg_preferred_pset, sched_boot_pset->pset_id, relaxed);
+#endif /* CONFIG_SCHED_EDGE */
 	/*
 	 * All thread groups should be initialized to be interactive; this allows the newly launched
 	 * thread groups to fairly compete with already running thread groups.
@@ -1473,7 +1510,12 @@ sched_clutch_destroy(
 static pset_id_t
 sched_edge_clutch_bucket_group_preferred_pset(sched_clutch_bucket_group_t clutch_bucket_group)
 {
-	return os_atomic_load(&clutch_bucket_group->scbg_preferred_pset, relaxed);
+	pset_id_t pset_id = os_atomic_load(&clutch_bucket_group->scbg_preferred_pset, relaxed);
+	/* sheng: the P pset exists only once its first core registers; until then threads run on the boot pset */
+	if (os_atomic_load(&pset_array[pset_id], acquire) == PROCESSOR_SET_NULL) {
+		return sched_boot_pset->pset_id;
+	}
+	return pset_id;
 }
 
